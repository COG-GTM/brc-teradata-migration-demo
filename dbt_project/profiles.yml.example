# =============================================================================
# dbt Profile Configuration (Example)
# Copy this file to ~/.dbt/profiles.yml and fill in your credentials.
# =============================================================================

barclays_migration:
  target: databricks  # Default target; switch to 'snowflake' or 'postgres_local'

  outputs:

    # -------------------------------------------------------------------------
    # Databricks Target (PRIMARY)
    #
    # Required environment variables:
    #   DATABRICKS_HOST        Workspace hostname, no scheme
    #                          e.g. adb-1234567890123456.7.azuredatabricks.net
    #   DATABRICKS_HTTP_PATH   SQL warehouse / cluster HTTP path
    #                          e.g. /sql/1.0/warehouses/abc123def456
    #   DATABRICKS_TOKEN       Personal access token (dapi...) -- omit if using
    #                          the OAuth (M2M) block below
    # Optional environment variables (defaults shown):
    #   DATABRICKS_CATALOG     Unity Catalog catalog       (barclays_migration)
    #   DATABRICKS_SCHEMA      Default schema              (public)
    #   DATABRICKS_THREADS     dbt thread count            (8)
    #   DATABRICKS_CLIENT_ID / DATABRICKS_CLIENT_SECRET
    #                          Service principal credentials for OAuth M2M
    # -------------------------------------------------------------------------
    databricks:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'barclays_migration') }}"
      schema: "{{ env_var('DATABRICKS_SCHEMA', 'public') }}"
      threads: "{{ env_var('DATABRICKS_THREADS', '8') | int }}"

      # --- Auth option A: personal access token (default) ---
      token: "{{ env_var('DATABRICKS_TOKEN') }}"

      # --- Auth option B: OAuth machine-to-machine (service principal) ---
      # Comment out `token:` above and uncomment the three lines below.
      # auth_type: oauth
      # client_id: "{{ env_var('DATABRICKS_CLIENT_ID') }}"
      # client_secret: "{{ env_var('DATABRICKS_CLIENT_SECRET') }}"

      connect_retries: 3
      connect_timeout: 180
      connect_max_idle: 60

    # -------------------------------------------------------------------------
    # Snowflake Target (SECONDARY)
    # -------------------------------------------------------------------------
    snowflake:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'TRANSFORMER') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'BARCLAYS_MIGRATION') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'TRANSFORMING') }}"
      schema: public
      threads: 4
      client_session_keep_alive: false
      query_tag: 'dbt_barclays_migration'

    # -------------------------------------------------------------------------
    # Local Postgres (for development via docker-compose)
    # -------------------------------------------------------------------------
    postgres_local:
      type: postgres
      host: localhost
      port: 5432
      user: dbt_user
      password: dbt_password
      dbname: barclays_migration
      schema: public
      threads: 4

    # -------------------------------------------------------------------------
    # Postgres CI (mirrors the target generated by .github/workflows/dbt_ci.yml)
    # -------------------------------------------------------------------------
    postgres_ci:
      type: postgres
      host: localhost
      port: 5432
      user: dbt_user
      password: dbt_password
      dbname: barclays_migration
      schema: public
      threads: 4
