/*******************************************************************************
 * claims_file_load.fl
 *
 * FastLoad script to bulk-load medical claims from a pipe-delimited flat
 * file into the CLAIMS_RAW.RAW_MEDICAL_CLAIM table.
 *
 * Input file format: pipe-delimited (|) with header row
 * Source: 837 Professional/Institutional claim extract from clearinghouse
 *
 * Pattern based on COG-GTM/Teradata-Utilities-Script Customer_fastload.fl.txt
 ******************************************************************************/

.LOGON ${TERADATA_HOST}/claims_etl,${ETL_PASSWORD};

DATABASE CLAIMS_RAW;

/* Drop error tables from any previous failed run */
DROP TABLE CLAIMS_RAW.MEDCLAIM_FL_ET;
DROP TABLE CLAIMS_RAW.MEDCLAIM_FL_UV;

BEGIN LOADING CLAIMS_RAW.RAW_MEDICAL_CLAIM
ERRORFILES CLAIMS_RAW.MEDCLAIM_FL_ET, CLAIMS_RAW.MEDCLAIM_FL_UV
CHECKPOINT 10000;

SET RECORD VARTEXT '|';

DEFINE
in_claim_id              (VARCHAR(30)),
in_member_id             (VARCHAR(20)),
in_claim_line_number     (VARCHAR(5)),
in_claim_type            (VARCHAR(5)),
in_service_date_from     (VARCHAR(10)),
in_service_date_to       (VARCHAR(10)),
in_admission_date        (VARCHAR(10)),
in_discharge_date        (VARCHAR(10)),
in_admit_type            (VARCHAR(5)),
in_admit_source          (VARCHAR(5)),
in_discharge_disposition (VARCHAR(5)),
in_place_of_service      (VARCHAR(5)),
in_bill_type             (VARCHAR(4)),
in_revenue_center_code   (VARCHAR(10)),
in_ms_drg                (VARCHAR(5)),
in_apr_drg               (VARCHAR(5)),
in_hcpcs_code            (VARCHAR(10)),
in_cpt_code              (VARCHAR(10)),
in_icd_diagnosis_code_1  (VARCHAR(10)),
in_icd_diagnosis_code_2  (VARCHAR(10)),
in_icd_diagnosis_code_3  (VARCHAR(10)),
in_icd_diagnosis_code_4  (VARCHAR(10)),
in_icd_diagnosis_code_5  (VARCHAR(10)),
in_icd_diagnosis_code_6  (VARCHAR(10)),
in_icd_diagnosis_code_7  (VARCHAR(10)),
in_icd_diagnosis_code_8  (VARCHAR(10)),
in_icd_diagnosis_code_9  (VARCHAR(10)),
in_icd_diagnosis_code_10 (VARCHAR(10)),
in_icd_diagnosis_code_11 (VARCHAR(10)),
in_icd_diagnosis_code_12 (VARCHAR(10)),
in_icd_diagnosis_code_13 (VARCHAR(10)),
in_icd_diagnosis_code_14 (VARCHAR(10)),
in_icd_diagnosis_code_15 (VARCHAR(10)),
in_icd_diagnosis_code_16 (VARCHAR(10)),
in_icd_diagnosis_code_17 (VARCHAR(10)),
in_icd_diagnosis_code_18 (VARCHAR(10)),
in_icd_diagnosis_code_19 (VARCHAR(10)),
in_icd_diagnosis_code_20 (VARCHAR(10)),
in_icd_diagnosis_code_21 (VARCHAR(10)),
in_icd_diagnosis_code_22 (VARCHAR(10)),
in_icd_diagnosis_code_23 (VARCHAR(10)),
in_icd_diagnosis_code_24 (VARCHAR(10)),
in_icd_diagnosis_code_25 (VARCHAR(10)),
in_icd_procedure_code_1  (VARCHAR(10)),
in_icd_procedure_code_2  (VARCHAR(10)),
in_icd_procedure_code_3  (VARCHAR(10)),
in_icd_procedure_code_4  (VARCHAR(10)),
in_icd_procedure_code_5  (VARCHAR(10)),
in_icd_procedure_code_6  (VARCHAR(10)),
in_npi                   (VARCHAR(10)),
in_billing_npi           (VARCHAR(10)),
in_rendering_npi         (VARCHAR(10)),
in_facility_npi          (VARCHAR(10)),
in_paid_amount           (VARCHAR(20)),
in_charge_amount         (VARCHAR(20)),
in_allowed_amount        (VARCHAR(20)),
in_coinsurance           (VARCHAR(20)),
in_copay                 (VARCHAR(20)),
in_deductible            (VARCHAR(20)),
in_claim_status          (VARCHAR(10)),
in_adjustment_type       (VARCHAR(10)),
in_original_claim_id     (VARCHAR(30)),
in_payer_id              (VARCHAR(20))
FILE=${INPUT_DIR}/medical_claims_${YYYYMMDD}.dat;

INSERT INTO CLAIMS_RAW.RAW_MEDICAL_CLAIM
(
    claim_id,
    member_id,
    claim_line_number,
    claim_type,
    service_date_from,
    service_date_to,
    admission_date,
    discharge_date,
    admit_type,
    admit_source,
    discharge_disposition,
    place_of_service,
    bill_type,
    revenue_center_code,
    ms_drg,
    apr_drg,
    hcpcs_code,
    cpt_code,
    icd_diagnosis_code_1,
    icd_diagnosis_code_2,
    icd_diagnosis_code_3,
    icd_diagnosis_code_4,
    icd_diagnosis_code_5,
    icd_diagnosis_code_6,
    icd_diagnosis_code_7,
    icd_diagnosis_code_8,
    icd_diagnosis_code_9,
    icd_diagnosis_code_10,
    icd_diagnosis_code_11,
    icd_diagnosis_code_12,
    icd_diagnosis_code_13,
    icd_diagnosis_code_14,
    icd_diagnosis_code_15,
    icd_diagnosis_code_16,
    icd_diagnosis_code_17,
    icd_diagnosis_code_18,
    icd_diagnosis_code_19,
    icd_diagnosis_code_20,
    icd_diagnosis_code_21,
    icd_diagnosis_code_22,
    icd_diagnosis_code_23,
    icd_diagnosis_code_24,
    icd_diagnosis_code_25,
    icd_procedure_code_1,
    icd_procedure_code_2,
    icd_procedure_code_3,
    icd_procedure_code_4,
    icd_procedure_code_5,
    icd_procedure_code_6,
    npi,
    billing_npi,
    rendering_npi,
    facility_npi,
    paid_amount,
    charge_amount,
    allowed_amount,
    coinsurance,
    copay,
    deductible,
    claim_status,
    adjustment_type,
    original_claim_id,
    payer_id
)
VALUES
(
    :in_claim_id,
    :in_member_id,
    CAST(:in_claim_line_number AS SMALLINT),
    :in_claim_type,
    CAST(:in_service_date_from AS DATE FORMAT 'YYYY-MM-DD'),
    CASE WHEN :in_service_date_to = '' THEN NULL
         ELSE CAST(:in_service_date_to AS DATE FORMAT 'YYYY-MM-DD') END,
    CASE WHEN :in_admission_date = '' THEN NULL
         ELSE CAST(:in_admission_date AS DATE FORMAT 'YYYY-MM-DD') END,
    CASE WHEN :in_discharge_date = '' THEN NULL
         ELSE CAST(:in_discharge_date AS DATE FORMAT 'YYYY-MM-DD') END,
    :in_admit_type,
    :in_admit_source,
    :in_discharge_disposition,
    :in_place_of_service,
    :in_bill_type,
    :in_revenue_center_code,
    :in_ms_drg,
    :in_apr_drg,
    :in_hcpcs_code,
    :in_cpt_code,
    CASE WHEN :in_icd_diagnosis_code_1  = '' THEN NULL ELSE :in_icd_diagnosis_code_1  END,
    CASE WHEN :in_icd_diagnosis_code_2  = '' THEN NULL ELSE :in_icd_diagnosis_code_2  END,
    CASE WHEN :in_icd_diagnosis_code_3  = '' THEN NULL ELSE :in_icd_diagnosis_code_3  END,
    CASE WHEN :in_icd_diagnosis_code_4  = '' THEN NULL ELSE :in_icd_diagnosis_code_4  END,
    CASE WHEN :in_icd_diagnosis_code_5  = '' THEN NULL ELSE :in_icd_diagnosis_code_5  END,
    CASE WHEN :in_icd_diagnosis_code_6  = '' THEN NULL ELSE :in_icd_diagnosis_code_6  END,
    CASE WHEN :in_icd_diagnosis_code_7  = '' THEN NULL ELSE :in_icd_diagnosis_code_7  END,
    CASE WHEN :in_icd_diagnosis_code_8  = '' THEN NULL ELSE :in_icd_diagnosis_code_8  END,
    CASE WHEN :in_icd_diagnosis_code_9  = '' THEN NULL ELSE :in_icd_diagnosis_code_9  END,
    CASE WHEN :in_icd_diagnosis_code_10 = '' THEN NULL ELSE :in_icd_diagnosis_code_10 END,
    CASE WHEN :in_icd_diagnosis_code_11 = '' THEN NULL ELSE :in_icd_diagnosis_code_11 END,
    CASE WHEN :in_icd_diagnosis_code_12 = '' THEN NULL ELSE :in_icd_diagnosis_code_12 END,
    CASE WHEN :in_icd_diagnosis_code_13 = '' THEN NULL ELSE :in_icd_diagnosis_code_13 END,
    CASE WHEN :in_icd_diagnosis_code_14 = '' THEN NULL ELSE :in_icd_diagnosis_code_14 END,
    CASE WHEN :in_icd_diagnosis_code_15 = '' THEN NULL ELSE :in_icd_diagnosis_code_15 END,
    CASE WHEN :in_icd_diagnosis_code_16 = '' THEN NULL ELSE :in_icd_diagnosis_code_16 END,
    CASE WHEN :in_icd_diagnosis_code_17 = '' THEN NULL ELSE :in_icd_diagnosis_code_17 END,
    CASE WHEN :in_icd_diagnosis_code_18 = '' THEN NULL ELSE :in_icd_diagnosis_code_18 END,
    CASE WHEN :in_icd_diagnosis_code_19 = '' THEN NULL ELSE :in_icd_diagnosis_code_19 END,
    CASE WHEN :in_icd_diagnosis_code_20 = '' THEN NULL ELSE :in_icd_diagnosis_code_20 END,
    CASE WHEN :in_icd_diagnosis_code_21 = '' THEN NULL ELSE :in_icd_diagnosis_code_21 END,
    CASE WHEN :in_icd_diagnosis_code_22 = '' THEN NULL ELSE :in_icd_diagnosis_code_22 END,
    CASE WHEN :in_icd_diagnosis_code_23 = '' THEN NULL ELSE :in_icd_diagnosis_code_23 END,
    CASE WHEN :in_icd_diagnosis_code_24 = '' THEN NULL ELSE :in_icd_diagnosis_code_24 END,
    CASE WHEN :in_icd_diagnosis_code_25 = '' THEN NULL ELSE :in_icd_diagnosis_code_25 END,
    CASE WHEN :in_icd_procedure_code_1  = '' THEN NULL ELSE :in_icd_procedure_code_1  END,
    CASE WHEN :in_icd_procedure_code_2  = '' THEN NULL ELSE :in_icd_procedure_code_2  END,
    CASE WHEN :in_icd_procedure_code_3  = '' THEN NULL ELSE :in_icd_procedure_code_3  END,
    CASE WHEN :in_icd_procedure_code_4  = '' THEN NULL ELSE :in_icd_procedure_code_4  END,
    CASE WHEN :in_icd_procedure_code_5  = '' THEN NULL ELSE :in_icd_procedure_code_5  END,
    CASE WHEN :in_icd_procedure_code_6  = '' THEN NULL ELSE :in_icd_procedure_code_6  END,
    :in_npi,
    :in_billing_npi,
    :in_rendering_npi,
    :in_facility_npi,
    CAST(:in_paid_amount AS DECIMAL(18,2)),
    CAST(:in_charge_amount AS DECIMAL(18,2)),
    CAST(:in_allowed_amount AS DECIMAL(18,2)),
    CAST(:in_coinsurance AS DECIMAL(18,2)),
    CAST(:in_copay AS DECIMAL(18,2)),
    CAST(:in_deductible AS DECIMAL(18,2)),
    :in_claim_status,
    :in_adjustment_type,
    CASE WHEN :in_original_claim_id = '' THEN NULL ELSE :in_original_claim_id END,
    :in_payer_id
);

END LOADING;
LOGOFF;
