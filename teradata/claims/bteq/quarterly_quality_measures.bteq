/*******************************************************************************
 * quarterly_quality_measures.bteq
 *
 * Quarterly quality measure calculation script (HEDIS-like measures).
 * Runs at the end of each quarter to calculate quality measure rates.
 *
 * Measures calculated:
 *   - BCS  (Breast Cancer Screening)
 *   - CCS  (Cervical Cancer Screening)
 *   - COL  (Colorectal Cancer Screening)
 *   - CDC  (Comprehensive Diabetes Care - HbA1c)
 *   - CBP  (Controlling High Blood Pressure)
 *   - PCE  (Pharmacotherapy for Opioid Use Disorder)
 *   - FUA  (Follow-Up After ED Visit for Alcohol/Drug Abuse)
 *   - AMM  (Antidepressant Medication Management)
 *
 * Scheduled: Quarterly (Apr 15, Jul 15, Oct 15, Jan 15) at 08:00 EST
 * Dependencies: All monthly enrollment refreshes for the quarter must complete
 ******************************************************************************/

.LOGON ${TERADATA_HOST}/claims_etl,${ETL_PASSWORD};

DATABASE CLAIMS_MART;

.SET WIDTH 200
.SET ERRORLEVEL 3807 SEVERITY 0
.SET ERRORLEVEL 3803 SEVERITY 0

/*---------------------------------------------------------------------------
 * Pre-flight: determine measurement period
 *---------------------------------------------------------------------------*/
SELECT 'Quarterly Quality Measures started at ' || CAST(CURRENT_TIMESTAMP AS VARCHAR(30));
.IF ERRORCODE <> 0 THEN .GOTO ERRORHANDLER

SELECT
    'Measurement year: ' || CAST(EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)) AS VARCHAR(4));

/*---------------------------------------------------------------------------
 * STEP 1: Calculate eligible populations and numerators
 * Using claims-based HEDIS logic
 *---------------------------------------------------------------------------*/
SELECT 'Step 1: Calculating quality measures';

/* Clear previous results for the measurement year */
DELETE FROM CLAIMS_MART.MART_QUALITY_MEASURES
WHERE measurement_year = EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3));
.IF ERRORCODE <> 0 THEN .GOTO ERRORHANDLER

/*---------------------------------------------------------------------------
 * Measure: BCS - Breast Cancer Screening
 * Eligible: Women 50-74 with continuous enrollment
 * Numerator: Mammography claim in measurement year or prior year
 *---------------------------------------------------------------------------*/
INSERT INTO CLAIMS_MART.MART_QUALITY_MEASURES (
    measure_id, measure_name, measure_category,
    measurement_year, payer_id, line_of_business,
    eligible_population, numerator_count, denominator_count,
    exclusion_count, rate,
    benchmark_50th, benchmark_75th, benchmark_90th,
    etl_batch_id, etl_loaded_ts
)
SELECT
    'BCS',
    'Breast Cancer Screening',
    'PREVENTIVE',
    EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)),
    mm.payer_id,
    mm.line_of_business,
    COUNT(DISTINCT mm.member_id) AS eligible_population,
    COUNT(DISTINCT CASE WHEN mc.claim_id IS NOT NULL THEN mm.member_id END) AS numerator_count,
    COUNT(DISTINCT mm.member_id) AS denominator_count,
    0 AS exclusion_count,
    CAST(COUNT(DISTINCT CASE WHEN mc.claim_id IS NOT NULL THEN mm.member_id END) AS DECIMAL(7,4))
        / NULLIFZERO(COUNT(DISTINCT mm.member_id)) AS rate,
    0.7500, 0.8200, 0.8800,
    CAST(CAST(CURRENT_DATE AS FORMAT 'YYYYMMDD') || '060' AS BIGINT),
    CURRENT_TIMESTAMP(6)
FROM CLAIMS_MART.MART_MEMBER_MONTHS mm
LEFT JOIN CLAIMS_DWH.FCT_MEDICAL_CLAIM mc
    ON mm.member_id = (
        SELECT dm.member_id FROM CLAIMS_DWH.DIM_MEMBER dm
        WHERE dm.member_sk = mc.member_sk AND dm.is_current = 'Y'
    )
    AND mc.cpt_code IN ('77055', '77056', '77057', '77061', '77062', '77063', '77065', '77066', '77067')
    AND mc.service_date_from_key BETWEEN
        CAST(CAST(EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)) - 1 AS CHAR(4)) || '0101' AS INTEGER)
        AND CAST(CAST(EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)) AS CHAR(4)) || '1231' AS INTEGER)
WHERE mm.year_number = EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3))
  AND mm.gender = 'F'
  AND mm.age_at_month BETWEEN 50 AND 74
GROUP BY mm.payer_id, mm.line_of_business;
.IF ERRORCODE <> 0 THEN .GOTO ERRORHANDLER
SELECT 'BCS measure calculated. Rows: ' || CAST(ACTIVITYCOUNT AS VARCHAR(20));

/*---------------------------------------------------------------------------
 * Measure: CDC - Comprehensive Diabetes Care (HbA1c Testing)
 * Eligible: Members 18-75 with diabetes diagnosis
 * Numerator: HbA1c lab claim in measurement year
 *---------------------------------------------------------------------------*/
INSERT INTO CLAIMS_MART.MART_QUALITY_MEASURES (
    measure_id, measure_name, measure_category,
    measurement_year, payer_id, line_of_business,
    eligible_population, numerator_count, denominator_count,
    exclusion_count, rate,
    benchmark_50th, benchmark_75th, benchmark_90th,
    etl_batch_id, etl_loaded_ts
)
SELECT
    'CDC-H',
    'Comprehensive Diabetes Care - HbA1c Testing',
    'CHRONIC',
    EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)),
    mm.payer_id,
    mm.line_of_business,
    COUNT(DISTINCT dm_diab.member_id) AS eligible_population,
    COUNT(DISTINCT CASE WHEN mc_hba1c.claim_id IS NOT NULL THEN dm_diab.member_id END) AS numerator_count,
    COUNT(DISTINCT dm_diab.member_id) AS denominator_count,
    0,
    CAST(COUNT(DISTINCT CASE WHEN mc_hba1c.claim_id IS NOT NULL THEN dm_diab.member_id END) AS DECIMAL(7,4))
        / NULLIFZERO(COUNT(DISTINCT dm_diab.member_id)),
    0.8500, 0.9000, 0.9400,
    CAST(CAST(CURRENT_DATE AS FORMAT 'YYYYMMDD') || '060' AS BIGINT),
    CURRENT_TIMESTAMP(6)
FROM CLAIMS_MART.MART_MEMBER_MONTHS mm
/* Identify diabetic members by diagnosis codes */
INNER JOIN (
    SELECT DISTINCT dm.member_id
    FROM CLAIMS_DWH.FCT_MEDICAL_CLAIM fc
    INNER JOIN CLAIMS_DWH.DIM_MEMBER dm ON fc.member_sk = dm.member_sk AND dm.is_current = 'Y'
    WHERE fc.icd_diagnosis_code_1 LIKE 'E11%'  /* Type 2 Diabetes */
       OR fc.icd_diagnosis_code_1 LIKE 'E10%'  /* Type 1 Diabetes */
       OR fc.icd_diagnosis_code_2 LIKE 'E11%'
       OR fc.icd_diagnosis_code_2 LIKE 'E10%'
) dm_diab ON mm.member_id = dm_diab.member_id
/* Check for HbA1c testing */
LEFT JOIN (
    SELECT DISTINCT
        dm2.member_id,
        fc2.claim_id
    FROM CLAIMS_DWH.FCT_MEDICAL_CLAIM fc2
    INNER JOIN CLAIMS_DWH.DIM_MEMBER dm2 ON fc2.member_sk = dm2.member_sk AND dm2.is_current = 'Y'
    WHERE fc2.cpt_code IN ('83036', '83037', '83039')
      AND fc2.service_date_from_key BETWEEN
          CAST(CAST(EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)) AS CHAR(4)) || '0101' AS INTEGER)
          AND CAST(CAST(EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)) AS CHAR(4)) || '1231' AS INTEGER)
) mc_hba1c ON dm_diab.member_id = mc_hba1c.member_id
WHERE mm.year_number = EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3))
  AND mm.age_at_month BETWEEN 18 AND 75
GROUP BY mm.payer_id, mm.line_of_business;
.IF ERRORCODE <> 0 THEN .GOTO ERRORHANDLER
SELECT 'CDC-H measure calculated. Rows: ' || CAST(ACTIVITYCOUNT AS VARCHAR(20));

/*---------------------------------------------------------------------------
 * Measure: AMM - Antidepressant Medication Management
 * Eligible: Members 18+ with new depression diagnosis + antidepressant Rx
 * Numerator: Continuous medication 84+ days (acute) or 180+ days (continuation)
 *---------------------------------------------------------------------------*/
INSERT INTO CLAIMS_MART.MART_QUALITY_MEASURES (
    measure_id, measure_name, measure_category,
    measurement_year, payer_id, line_of_business,
    eligible_population, numerator_count, denominator_count,
    exclusion_count, rate,
    benchmark_50th, benchmark_75th, benchmark_90th,
    etl_batch_id, etl_loaded_ts
)
SELECT
    'AMM-A',
    'Antidepressant Medication Management - Acute Phase',
    'BEHAVIORAL',
    EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)),
    mm.payer_id,
    mm.line_of_business,
    COUNT(DISTINCT mm.member_id) AS eligible_population,
    COUNT(DISTINCT CASE WHEN rx_days.total_days_supply >= 84 THEN mm.member_id END) AS numerator_count,
    COUNT(DISTINCT mm.member_id) AS denominator_count,
    0,
    CAST(COUNT(DISTINCT CASE WHEN rx_days.total_days_supply >= 84 THEN mm.member_id END) AS DECIMAL(7,4))
        / NULLIFZERO(COUNT(DISTINCT mm.member_id)),
    0.6000, 0.6800, 0.7500,
    CAST(CAST(CURRENT_DATE AS FORMAT 'YYYYMMDD') || '060' AS BIGINT),
    CURRENT_TIMESTAMP(6)
FROM CLAIMS_MART.MART_MEMBER_MONTHS mm
/* Members with depression diagnosis */
INNER JOIN (
    SELECT DISTINCT dm.member_id
    FROM CLAIMS_DWH.FCT_MEDICAL_CLAIM fc
    INNER JOIN CLAIMS_DWH.DIM_MEMBER dm ON fc.member_sk = dm.member_sk AND dm.is_current = 'Y'
    WHERE fc.icd_diagnosis_code_1 LIKE 'F32%'  /* Major depressive disorder */
       OR fc.icd_diagnosis_code_1 LIKE 'F33%'  /* Recurrent depression */
) depr ON mm.member_id = depr.member_id
/* Calculate total days supply of antidepressants */
LEFT JOIN (
    SELECT
        dm3.member_id,
        SUM(ZEROIFNULL(fp.days_supply)) AS total_days_supply
    FROM CLAIMS_DWH.FCT_PHARMACY_CLAIM fp
    INNER JOIN CLAIMS_DWH.DIM_MEMBER dm3 ON fp.member_sk = dm3.member_sk AND dm3.is_current = 'Y'
    WHERE fp.dispensing_date_key BETWEEN
        CAST(CAST(EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)) AS CHAR(4)) || '0101' AS INTEGER)
        AND CAST(CAST(EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3)) AS CHAR(4)) || '1231' AS INTEGER)
    /* NDC codes for common antidepressants - simplified for demo */
    AND SUBSTR(fp.ndc_code, 1, 5) IN ('00378', '00093', '65862', '68382', '16714')
    GROUP BY dm3.member_id
) rx_days ON mm.member_id = rx_days.member_id
WHERE mm.year_number = EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3))
  AND mm.age_at_month >= 18
GROUP BY mm.payer_id, mm.line_of_business;
.IF ERRORCODE <> 0 THEN .GOTO ERRORHANDLER
SELECT 'AMM-A measure calculated. Rows: ' || CAST(ACTIVITYCOUNT AS VARCHAR(20));

/*---------------------------------------------------------------------------
 * STEP 2: Assign star ratings based on benchmarks
 *---------------------------------------------------------------------------*/
SELECT 'Step 2: Assigning star ratings';

UPDATE CLAIMS_MART.MART_QUALITY_MEASURES
SET star_rating = CASE
        WHEN rate >= benchmark_90th THEN 5
        WHEN rate >= benchmark_75th THEN 4
        WHEN rate >= benchmark_50th THEN 3
        WHEN rate >= benchmark_50th * 0.75 THEN 2
        ELSE 1
    END,
    performance_level = CASE
        WHEN rate >= benchmark_90th THEN 'EXCELLENT'
        WHEN rate >= benchmark_75th THEN 'ABOVE_AVG'
        WHEN rate >= benchmark_50th THEN 'AVERAGE'
        ELSE 'BELOW_AVG'
    END
WHERE measurement_year = EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3));
.IF ERRORCODE <> 0 THEN .GOTO ERRORHANDLER
SELECT 'Star ratings assigned: ' || CAST(ACTIVITYCOUNT AS VARCHAR(20));

/*---------------------------------------------------------------------------
 * STEP 3: Collect statistics
 *---------------------------------------------------------------------------*/
COLLECT STATISTICS ON CLAIMS_MART.MART_QUALITY_MEASURES
    COLUMN (measure_id, measurement_year, payer_id);

/*---------------------------------------------------------------------------
 * Post-calculation validation
 *---------------------------------------------------------------------------*/
SELECT 'Quality Measure Summary:';
SELECT
    measure_id,
    measure_name,
    line_of_business,
    eligible_population,
    numerator_count,
    rate,
    star_rating,
    performance_level
FROM CLAIMS_MART.MART_QUALITY_MEASURES
WHERE measurement_year = EXTRACT(YEAR FROM ADD_MONTHS(CURRENT_DATE, -3))
ORDER BY measure_id, line_of_business;

SELECT 'Quarterly Quality Measures completed successfully at ' || CAST(CURRENT_TIMESTAMP AS VARCHAR(30));
.GOTO FINISH

/*---------------------------------------------------------------------------
 * Error handler
 *---------------------------------------------------------------------------*/
.LABEL ERRORHANDLER
SELECT 'ERROR: Quarterly Quality Measures failed at ' || CAST(CURRENT_TIMESTAMP AS VARCHAR(30));
SELECT 'Last ERRORCODE: ' || CAST(ERRORCODE AS VARCHAR(10));
.QUIT 12

.LABEL FINISH
.LOGOFF;
.QUIT 0;
