          "source_files": ["databricks/notebooks/01_claims_ingestion.py"]
        },
        "snowflake": {
          "database": "CLAIMS_DW",
          "schema": "RAW",
          "tables": ["RAW_MEMBER_ELIGIBILITY", "RAW_MEDICAL_CLAIM", "RAW_PHARMACY_CLAIM"],
          "ingestion_method": "Snowpipe + Tasks",
          "source_files": ["snowflake/tasks/daily_claims_pipeline_task.sql"]
        }
      }
    },
    "staging_layer": {
      "unified_target": "healthcare_dbt/models/staging/",
      "models": [
        {
          "model": "stg_teradata__eligibility",
          "source": "teradata.CLAIMS_RAW.RAW_MEMBER_ELIGIBILITY",
          "key_transforms": ["member_id → person_id", "CHAR → VARCHAR", "RANGE_N PPI removed"]
        },
        {
          "model": "stg_teradata__medical_claim",
          "source": "teradata.CLAIMS_RAW.RAW_MEDICAL_CLAIM",
          "key_transforms": ["service_date_from → claim_start_date", "25 diag columns preserved", "claim_type I/P/O normalized"]
        },
        {
          "model": "stg_teradata__pharmacy_claim",
          "source": "teradata.CLAIMS_RAW.RAW_PHARMACY_CLAIM",
          "key_transforms": ["member_id → person_id", "SMALLINT → INTEGER"]
        },
        {
          "model": "stg_databricks__eligibility",
          "source": "databricks.claims_raw.raw_member_eligibility",
          "key_transforms": ["coverage_start/end → enrollment_start/end", "STRING → VARCHAR"]
        },
        {
          "model": "stg_databricks__medical_claim",
          "source": "databricks.claims_raw.raw_medical_claim",
          "key_transforms": ["patient_id → person_id", "ARRAY<STRING> → 25 columns", "DOUBLE → NUMBER(18,2)"]
        },
        {
          "model": "stg_databricks__pharmacy_claim",
          "source": "databricks.claims_raw.raw_pharmacy_claim",
          "key_transforms": ["patient_id → person_id", "fill_date → dispensing_date"]
        },
        {
          "model": "stg_snowflake__eligibility",
          "source": "snowflake.CLAIMS_DW.RAW.RAW_MEMBER_ELIGIBILITY",
          "key_transforms": ["eligibility_start/end → enrollment_start/end", "plan_code → plan"]
        },
        {
          "model": "stg_snowflake__medical_claim",
          "source": "snowflake.CLAIMS_DW.RAW.RAW_MEDICAL_CLAIM",
          "key_transforms": ["Hybrid VARIANT+columns → 25 columns", "start/end_date → claim_start/end_date", "status_code → claim_status"]
        },
        {
          "model": "stg_snowflake__pharmacy_claim",
          "source": "snowflake.CLAIMS_DW.RAW.RAW_PHARMACY_CLAIM",
          "key_transforms": ["fill_date → dispensing_date", "status_code → claim_status"]
        }
      ]
    },
    "intermediate_layer": {
      "unified_target": "healthcare_dbt/models/intermediate/",
      "models": [
        {
