          "replaces": ["teradata.V_MEMBER_LATEST", "databricks member dedup logic", "snowflake member dedup logic"],
          "drift_resolved": ["DRIFT-005 (member dedup sort order)"]
        },
        {
          "model": "int_member_month_enrollment",
          "sources": ["int_eligibility_deduped"],
          "replaces": ["teradata.sp_member_month_enrollment (EXPAND ON)", "databricks member month logic", "snowflake member month logic"],
          "drift_resolved": []
        }
      ]
    },
    "mart_layer": {
      "unified_target": "healthcare_dbt/models/marts/",
      "models": [
        {
          "model": "mart_claim_summary",
          "sources": ["int_medical_claim_adr_deduped", "int_pharmacy_claim_adr_deduped"],
          "purpose": "Executive dashboard - claim counts, financial totals by type/status/month"
        },
        {
          "model": "mart_encounter_summary",
          "sources": ["int_encounter_grouped"],
          "purpose": "Utilization analytics - encounter counts, LOS, costs by type/month"
        },
        {
          "model": "mart_member_months",
          "sources": ["int_member_month_enrollment", "int_medical_claim_adr_deduped", "int_pharmacy_claim_adr_deduped", "int_encounter_grouped"],
          "purpose": "PMPM metrics - per member per month medical/pharmacy/total costs"
        }
