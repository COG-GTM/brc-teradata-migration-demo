        },
        {
          "model": "int_pharmacy_claim_adr_deduped",
          "sources": ["stg_teradata__pharmacy_claim", "stg_databricks__pharmacy_claim", "stg_snowflake__pharmacy_claim"],
          "replaces": ["teradata.sp_claims_adr_dedup (pharmacy section)", "databricks.02_adr_deduplication.py (pharmacy)", "snowflake.SP_CLAIMS_ADR_DEDUP (pharmacy)"],
          "drift_resolved": ["DRIFT-001 (ADR priority)"]
        },
        {
          "model": "int_encounter_grouped",
          "sources": ["int_medical_claim_adr_deduped"],
          "replaces": ["teradata.sp_encounter_grouping", "databricks.03_encounter_grouping.py", "snowflake.SP_ENCOUNTER_GROUPING"],
          "drift_resolved": ["DRIFT-002 (encounter grouping algorithm)"]
