{
  "metadata": {
    "generated_date": "2026-04-10",
    "description": "Phase 9: Cross-platform lineage map - every object on every legacy platform mapped to its unified equivalent"
  },
  "lineage": {
    "raw_layer": {
      "unified_target": "CLAIMS_DW.RAW.*",
      "ingestion": "orchestration/01_daily_claims_pipeline.sql (Snowpipe + COPY INTO)",
      "sources": {
        "teradata": {
          "database": "CLAIMS_RAW",
          "tables": ["RAW_MEMBER_ELIGIBILITY", "RAW_MEDICAL_CLAIM", "RAW_PHARMACY_CLAIM"],
          "ingestion_method": "BTEQ .IMPORT / FastLoad",
          "source_files": ["teradata/claims/bteq/daily_claims_load.bteq", "teradata/claims/fastload/claims_file_load.fl"]
        },
        "databricks": {
          "database": "claims_raw",
          "tables": ["raw_member_eligibility", "raw_medical_claim", "raw_pharmacy_claim"],
