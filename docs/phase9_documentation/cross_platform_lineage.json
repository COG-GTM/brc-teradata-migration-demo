      ],
      "pipes": [
        {"pipe": "PIPE_MEDICAL_CLAIMS", "replaces": ["BTEQ .IMPORT", "Auto Loader"]},
        {"pipe": "PIPE_PHARMACY_CLAIMS", "replaces": ["BTEQ .IMPORT", "Auto Loader"]},
        {"pipe": "PIPE_ELIGIBILITY", "replaces": ["BTEQ .IMPORT", "Auto Loader"]}
